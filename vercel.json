{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/client-errors.js": {
      "regions": ["gru1"]
    },
    "api/health.js": {
      "regions": ["gru1"]
    },
    "api/import-riftbound-deck.js": {
      "regions": ["gru1"]
    },
    "api/liga-one-piece.js": {
      "regions": ["gru1"]
    }
  },
  "headers": [
    {
      "source": "/(index.html|flutter.js|flutter_bootstrap.js|main.dart.js|version.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/pwa_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.gstatic.com; worker-src 'self' blob: https://cdn.jsdelivr.net https://www.gstatic.com; connect-src 'self' https://sslfaerultjnjfkivved.supabase.co https://*.supabase.co https://www.ligaonepiece.com.br https://ligaonepiece.com.br https://www.optcgapi.com https://api.heroi.cc https://api.pokemontcg.io https://api.magicthegathering.io https://api.scryfall.com https://db.ygoprodeck.com https://digimoncard.io https://api.riftcodex.com https://riftcodex.com https://www.gstatic.com https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Language",
          "value": "pt-BR"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ]
}
